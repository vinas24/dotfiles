{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
	"type":"kitty",
	"padding": {
		"top": 1,
		"left":3
	}
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "magenta"
        }
    },
    "modules": [
	{
	    "type":"custom",
	    "key":"╭───────────╮"
	},
        {
            "type": "title",
            "key": "│  {#31} User   {#keys}│",
            "format": "{user-name}"
        },
        {
            "type": "title",
            "key": "│  {#32}󰒋 Host   {#keys}│",
            "format": "{host-name}"
        },
        {
            "type": "host",
            "key": "│  {#33}󰌢 Model  {#keys}│"
        },
        {
            "type": "os",
            "key": "│  {#34} OS     {#keys}│",
            "format": "{pretty-name} {version-id} {arch}"
        },
        {
            "type": "kernel",
            "key": "│  {#35} Kern   {#keys}│"
        },
        {
            "type": "uptime",
            "key": "│  {#36}󱎫 Uptime {#keys}│"
        },
        {
            "type": "processes",
            "key": "│  {#31}󰑭 Proc   {#keys}│"
        }, 
        {
            "type": "wm",
            "key": "│  {#33} WM     {#keys}│"
        },
        {
            "type": "de",
            "key": "│  {#34}󰧨 DE     {#keys}│"
        },
        {
            "type": "shell",
            "key": "│  {#35} Shell  {#keys}│"
        },
        {
            "type": "terminal",
            "key": "│  {#36} Term   {#keys}│",
            "format": "{pretty-name} {version}" 
        },
        {
            "type": "packages",
   		"key": "│  {#31}󰏖 Pkgs   {#keys}│",
            "format": "{all}"
        },
        {
            "type": "cpu",
            "key": "│  {#33} CPU    {#keys}│",
	    "temp" : true,
            "format": "{cores-logical} x {name} {temperature}"
        },
        {
            "type": "gpu",
            "key": "│  {#34}󰢮 GPU    {#keys}│",
	    "temp":true,
            "format": "{name} {temperature}"
        },
        {
            "type": "memory",
            "key": "│  {#35}󰍛 RAM    {#keys}│"
        },
        {
            "type": "disk",
            "key": "│  {#36}󰋊 Disk   {#keys}│",
            "folders": "/"
        },
        {
            "type": "localip",
            "key": "│  {#31}󰩟 LAN    {#keys}│",
            "showIpv6": true,
            "showPrefixLen": false
        },
	{
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
