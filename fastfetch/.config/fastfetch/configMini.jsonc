{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small"
    },
    "display": {
        "separator": "  ",
        "key": {
            "type": "icon"
        }
    },
    "modules": [
        {
            "type": "title",
            "color": {
                "user": "red",
                "at": "white",
                "host": "red"
            }
        },
	{
		"type": "os",
		"keyColor":"green"
	},
	{
		"type":"wm",
		"keyColor":"blue" 
	},
	{
		"type":"shell",
		"keyColor":"magenta" 
	},
	{
		"type":"terminal",
		"keyColor":"yellow" 
	},
	{
		"type":"memory",
		"keyColor":"magenta" 
	},
        {
		"type":"uptime",
		"keyColor":"cyan" 
	}
        
    ]
}
